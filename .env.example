# Copy to .env and adjust.
DATABASE_URL=postgres://boekhouden:boekhouden@localhost:5432/boekhouden
DATABASE_URL_TEST=postgres://boekhouden:boekhouden@localhost:5432/boekhouden_test

# Auth.js: generate a secret with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000

# Any SMTP server (free options: Gmail with an app password, Brevo free tier).
# Locally: Mailpit from docker-compose. Leave empty to print mails to the console.
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM="Boekhouding Dispuut <fiscus@example.nl>"

# S3-compatible storage (used from build step f). Locally: MinIO from docker-compose.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=boekhouden
S3_ACCESS_KEY=boekhouden
S3_SECRET_KEY=boekhouden-secret
