# Only needed when running the app yourself. Online (Vercel) you set these under
# Settings → Environment Variables; DATABASE_URL is added automatically by the Neon integration.

# Postgres, e.g. a free Neon database (https://neon.tech). Use the pooled URL here.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional: direct (unpooled) URL for migrations. Neon's Vercel integration sets this.
DATABASE_URL_UNPOOLED=
# Separate, empty database for automated tests (developers only).
DATABASE_URL_TEST=

# Random secret for login sessions (at least 32 characters).
AUTH_SECRET=change-me

# Your own secret code, asked by the setup wizard (/setup) so only you can set up the association.
SETUP_CODE=change-me

# SMTP for login links and monthly mails. Free: Gmail with an app password:
#   smtps://yourname%40gmail.com:app-password-without-spaces@smtp.gmail.com:465
# Leave empty to print mails to the server log instead.
EMAIL_SERVER=
EMAIL_FROM="Fiscus Dispuut <yourname@gmail.com>"
